#define boidBlockSize 256

struct Boid {
  float3 pos;
  float3 vel;
};

StructuredBuffer<Boid> boidsIn;
RWStructuredBuffer<Boid> boidsOut;
uniform uint numBoids;
uniform uint boidStride;
uniform float deltaTime;
uniform float maxSpeed;
uniform float minSpeed;
uniform float visualRangeSq;
uniform float cohesionFactor;
uniform float separationFactor;
uniform float alignmentFactor;
uniform float minDistanceSq;
uniform float turnSpeed;
uniform float xBound;
uniform float yBound;
uniform float zBound;

StructuredBuffer<uint> gridOffsetBuffer;
RWStructuredBuffer<uint> gridOffsetBufferIn;
RWStructuredBuffer<uint> gridBuffer;
float gridInverseCellSize;
uint gridDimX;
uint gridDimY;
uint gridDimZ;

uint3 getGridLocation(Boid boid) {
  int boidX = (int)floor(boid.pos.x * gridInverseCellSize) + (int)(gridDimX / 2);
  int boidY = (int)floor(boid.pos.y * gridInverseCellSize) + (int)(gridDimY / 2);
  int boidZ = (int)floor(boid.pos.z * gridInverseCellSize) + (int)(gridDimZ / 2);
  return uint3(boidX, boidY, boidZ);
}

uint getGridID(uint3 pos) {
  return (gridDimY * gridDimX * pos.z) + (gridDimX * pos.y) + pos.x;
}

uint getBoidIndex(uint3 id) {
  return id.y * boidStride + id.x;
}

#define searchBlockSize 64
#define tileSize 160
groupshared float4 tilePosVelX[tileSize];
groupshared float2 tileVelYZ[tileSize];
uniform uint updateGroupsX;

void AddNeighbour(float3 pos, float3 otherPos, float3 otherVel, inout float3 center, inout float3 close, inout float3 avgVel, inout uint neighbours) {
  float3 diff = pos - otherPos;
  float distSq = dot(diff, diff);
  if (distSq < visualRangeSq && distSq > 0) {
    if (distSq < minDistanceSq) {
      float invDistSq = 1.0 / distSq;
      close += diff * invDistSq;
    }
    center += otherPos;
    avgVel += otherVel;
    neighbours++;
  }
}

void MergedBehaviours(inout Boid boid, uint localID, uint firstCell, uint lastCell) {
  float3 center = 0;
  float3 close = 0;
  float3 avgVel = 0;
  uint neighbours = 0;

  uint cell = getGridID(getGridLocation(boid));
  uint zStep = gridDimX * gridDimY;

  // Loop around own cell (3x3x3 neighborhood)
  [loop]
  for (int z = -1; z <= 1; z++) {
    [loop]
    for (int y = -1; y <= 1; y++) {
      uint row = z * zStep + y * gridDimX;
      uint start = gridOffsetBuffer[cell + row - 1];
      uint end = gridOffsetBuffer[cell + row + 2];
      uint tileStart = gridOffsetBuffer[firstCell + row - 1];
      uint tileCount = gridOffsetBuffer[lastCell + row + 2] - tileStart;
      bool tiled = tileCount <= tileSize;

      GroupMemoryBarrierWithGroupSync();
      if (tiled) {
        for (uint k = localID; k < tileCount; k += searchBlockSize) {
          Boid other = boidsIn[tileStart + k];
          tilePosVelX[k] = float4(other.pos, other.vel.x);
          tileVelYZ[k] = other.vel.yz;
        }
      }
      GroupMemoryBarrierWithGroupSync();

      if (tiled) {
        uint j = start - tileStart;
        uint tileEnd = end - tileStart;
        for (; j + 3 < tileEnd; j += 4) {
          float4 o0 = tilePosVelX[j];
          float4 o1 = tilePosVelX[j + 1];
          float4 o2 = tilePosVelX[j + 2];
          float4 o3 = tilePosVelX[j + 3];
          float2 v0 = tileVelYZ[j];
          float2 v1 = tileVelYZ[j + 1];
          float2 v2 = tileVelYZ[j + 2];
          float2 v3 = tileVelYZ[j + 3];
          AddNeighbour(boid.pos, o0.xyz, float3(o0.w, v0), center, close, avgVel, neighbours);
          AddNeighbour(boid.pos, o1.xyz, float3(o1.w, v1), center, close, avgVel, neighbours);
          AddNeighbour(boid.pos, o2.xyz, float3(o2.w, v2), center, close, avgVel, neighbours);
          AddNeighbour(boid.pos, o3.xyz, float3(o3.w, v3), center, close, avgVel, neighbours);
        }
        for (; j < tileEnd; j++) {
          float4 other = tilePosVelX[j];
          AddNeighbour(boid.pos, other.xyz, float3(other.w, tileVelYZ[j]), center, close, avgVel, neighbours);
        }
      } else {
        for (uint j = start; j < end; j++) {
          Boid other = boidsIn[j];
          AddNeighbour(boid.pos, other.pos, other.vel, center, close, avgVel, neighbours);
        }
      }
    }
  }

  if (neighbours > 0) {
    float invNeighbours = 1.0 / neighbours;
    center *= invNeighbours;
    avgVel *= invNeighbours;

    boid.vel += (center - boid.pos) * (cohesionFactor * deltaTime);
    boid.vel += (avgVel - boid.vel) * (alignmentFactor * deltaTime);
  }

  boid.vel += close * (separationFactor * deltaTime);
}

void LimitSpeed(inout Boid boid) {
  float speed = length(boid.vel);
  float clampedSpeed = clamp(speed, minSpeed, maxSpeed);
  boid.vel *= clampedSpeed / speed;
}

void KeepInBounds(inout Boid boid) {
  if (abs(boid.pos.x) > xBound) {
    boid.vel.x -= sign(boid.pos.x) * deltaTime * turnSpeed;
  }
  if (abs(boid.pos.y) > yBound) {
    boid.vel.y -= sign(boid.pos.y) * deltaTime * turnSpeed;
  }
  if (abs(boid.pos.z) > zBound) {
    boid.vel.z -= sign(boid.pos.z) * deltaTime * turnSpeed;
  }
}

#pragma kernel UpdateBoids // ID 0
[numthreads(searchBlockSize, 1, 1)]
void UpdateBoids(uint3 groupID : SV_GroupID, uint localID : SV_GroupIndex) {
  uint first = (groupID.y * updateGroupsX + groupID.x) * searchBlockSize;
  if (first >= numBoids) {
    return;
  }
  // Threads past the last boid still take part in the staging, as copies of the last boid
  uint last = min(first + searchBlockSize, numBoids) - 1;
  uint i = first + localID;
  Boid boid = boidsIn[min(i, last)];
  uint firstCell = getGridID(getGridLocation(boidsIn[first]));
  uint lastCell = getGridID(getGridLocation(boidsIn[last]));

  MergedBehaviours(boid, localID, firstCell, lastCell);
  LimitSpeed(boid);
  KeepInBounds(boid);

  // Update positions
  boid.pos += boid.vel * deltaTime;

  if (i < numBoids) {
    boidsOut[i] = boid;
    InterlockedAdd(gridOffsetBufferIn[getGridID(getGridLocation(boid))], 1, gridBuffer[i]);
  }
}

// Stateless random generation
uint randSeed;
uint pcg_hash(uint input) {
  uint state = input * 747796405u + 2891336453u;
  uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
  return (word >> 22u) ^ word;
}

float randPCG(uint input, float min, float max) {
  float f = pcg_hash(input) * (1.0 / 4294967296.0);
  return f * (max - min) + min;
}

#pragma kernel GenerateBoids // ID 1
[numthreads(boidBlockSize, 1, 1)]
void GenerateBoids(uint3 id : SV_DispatchThreadID) {
  uint i = getBoidIndex(id);
  if (i >= numBoids) {
    return;
  }

  uint base = randSeed + i * 6u;
  boidsOut[i].pos = float3(randPCG(base + 0u, -xBound, xBound), randPCG(base + 1u, -yBound, yBound), randPCG(base + 2u, -zBound, zBound));
  boidsOut[i].vel = float3(randPCG(base + 3u, -maxSpeed, maxSpeed), randPCG(base + 4u, -maxSpeed, maxSpeed), randPCG(base + 5u, -maxSpeed, maxSpeed));
}
