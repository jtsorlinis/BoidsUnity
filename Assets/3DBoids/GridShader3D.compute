#define blockSize 256
#define boidBlockSize 256
// Each prefix sum group covers 4 rows of blockSize cells, so loads and stores stay coalesced
#define blockCells (blockSize * 4)

struct Boid {
  float3 pos;
  float3 vel;
};

StructuredBuffer<Boid> boids;
RWStructuredBuffer<uint> sortedIndices;
RWStructuredBuffer<uint> gridBuffer;
RWStructuredBuffer<uint> gridOffsetBuffer;
RWStructuredBuffer<uint> gridOffsetBufferIn;
RWStructuredBuffer<uint> gridSumsBuffer;
StructuredBuffer<uint> gridSumsBufferIn;

float gridInverseCellSize;
uint gridDimX;
uint gridDimY;
uint gridDimZ;
uint gridTotalCells;
uint blocks;
uint numBoids;
uint boidStride;

uint getGridID(Boid boid) {
  int boidX = (int)floor(boid.pos.x * gridInverseCellSize) + (int)(gridDimX / 2);
  int boidY = (int)floor(boid.pos.y * gridInverseCellSize) + (int)(gridDimY / 2);
  int boidZ = (int)floor(boid.pos.z * gridInverseCellSize) + (int)(gridDimZ / 2);
  return (gridDimY * gridDimX * boidZ) + (gridDimX * boidY) + boidX;
}

uint getBoidIndex(uint3 id) {
  return id.y * boidStride + id.x;
}

uint getCell(uint groupID, uint localID, uint row) {
  return groupID * blockCells + row * blockSize + localID;
}

#pragma kernel UpdateGrid // ID 0
[numthreads(boidBlockSize, 1, 1)]
void UpdateGrid(uint3 id : SV_DispatchThreadID) {
  uint i = getBoidIndex(id);
  if (i >= numBoids) {
    return;
  }

  InterlockedAdd(gridOffsetBuffer[getGridID(boids[i])], 1, gridBuffer[i]);
}

#pragma kernel ClearGrid // ID 1
[numthreads(blockSize, 1, 1)]
void ClearGrid(uint localID : SV_GROUPTHREADID, uint groupID : SV_GROUPID) {
  [unroll]
  for (uint row = 0; row < 4; row++) {
    uint cell = getCell(groupID, localID, row);
    if (cell < gridTotalCells) {
      gridOffsetBuffer[cell] = 0;
    }
  }
}

groupshared uint4 scanTemp[2][blockSize];

// Exclusive scan of a group's 4 rows of values in row order, total gets their sum
uint4 GroupScan(uint4 values, uint localID, out uint total) {
  GroupMemoryBarrierWithGroupSync();
  uint4 inclusive = values;
  uint buf = 0;
  [unroll]
  for (uint offset = 1; offset < blockSize; offset *= 2) {
    scanTemp[buf][localID] = inclusive;
    GroupMemoryBarrierWithGroupSync();
    if (localID >= offset) {
      inclusive += scanTemp[buf][localID - offset];
    }
    buf ^= 1;
  }
  buf ^= 1;
  uint4 rowTotals = scanTemp[buf][blockSize - 1] + scanTemp[buf][blockSize / 2 - 1];
  total = rowTotals.x + rowTotals.y + rowTotals.z + rowTotals.w;
  return inclusive - values + uint4(0, rowTotals.x, rowTotals.x + rowTotals.y, total - rowTotals.w);
}

groupshared uint sumTemp[blockSize];
#pragma kernel SumBlocks // ID 2
[numthreads(blockSize, 1, 1)]
void SumBlocks(uint localID : SV_GROUPTHREADID, uint groupID : SV_GROUPID) {
  uint sum = 0;
  [unroll]
  for (uint row = 0; row < 4; row++) {
    uint cell = getCell(groupID, localID, row);
    if (cell < gridTotalCells) {
      sum += gridOffsetBufferIn[cell];
    }
  }
  sumTemp[localID] = sum;
  GroupMemoryBarrierWithGroupSync();

  [unroll]
  for (uint stride = blockSize / 2; stride > 0; stride /= 2) {
    if (localID < stride) {
      sumTemp[localID] += sumTemp[localID + stride];
    }
    GroupMemoryBarrierWithGroupSync();
  }

  if (localID == 0) {
    gridSumsBuffer[groupID] = sumTemp[0];
  }
}

// Single group, turns the block totals into block offsets in place
#pragma kernel ScanSums // ID 3
[numthreads(blockSize, 1, 1)]
void ScanSums(uint localID : SV_GROUPTHREADID) {
  uint carry = 0;
  for (uint first = 0; first < blocks; first += blockCells) {
    uint4 sums = 0;
    uint row;
    [unroll]
    for (row = 0; row < 4; row++) {
      uint i = first + row * blockSize + localID;
      if (i < blocks) {
        sums[row] = gridSumsBuffer[i];
      }
    }

    uint total;
    uint4 offsets = GroupScan(sums, localID, total) + carry;
    [unroll]
    for (row = 0; row < 4; row++) {
      uint i = first + row * blockSize + localID;
      if (i < blocks) {
        gridSumsBuffer[i] = offsets[row];
      }
    }
    carry += total;
  }
}

#pragma kernel PrefixSum // ID 4
[numthreads(blockSize, 1, 1)]
void PrefixSum(uint localID : SV_GROUPTHREADID, uint groupID : SV_GROUPID) {
  uint4 counts = 0;
  uint row;
  [unroll]
  for (row = 0; row < 4; row++) {
    uint cell = getCell(groupID, localID, row);
    if (cell < gridTotalCells) {
      counts[row] = gridOffsetBufferIn[cell];
    }
  }

  uint total;
  uint4 offsets = GroupScan(counts, localID, total) + gridSumsBufferIn[groupID];
  [unroll]
  for (row = 0; row < 4; row++) {
    uint cell = getCell(groupID, localID, row);
    if (cell < gridTotalCells) {
      gridOffsetBuffer[cell] = offsets[row];
      gridOffsetBufferIn[cell] = 0;
    }
  }
}

#pragma kernel RearrangeBoids // ID 5
[numthreads(boidBlockSize, 1, 1)]
void RearrangeBoids(uint3 id : SV_DispatchThreadID) {
  uint i = getBoidIndex(id);
  if (i >= numBoids) {
    return;
  }
  
  Boid boid = boids[i];
  uint index = gridOffsetBuffer[getGridID(boid)] + gridBuffer[i];
  sortedIndices[index] = i;
}
