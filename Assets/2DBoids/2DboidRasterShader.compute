#define boidBlockSize 256

#include "BoidRaster.hlsl"

struct Boid {
  float2 pos;
  float2 vel;
};

StructuredBuffer<Boid> boids;

uint numBoids;
uint boidStride;
float4 backgroundColor;

uint getBoidIndex(uint3 id) {
  return id.y * boidStride + id.x;
}

#pragma kernel ClearRaster
[numthreads(8, 8, 1)]
void ClearRaster(uint3 id : SV_DispatchThreadID) {
  int2 pixel = int2(id.xy);
  if (pixel.x >= rasterWidth || pixel.y >= rasterHeight) {
    return;
  }

  rasterTarget[pixel] = backgroundColor;
}

// Only used in CPU mode
#pragma kernel RasterizeBoids
[numthreads(boidBlockSize, 1, 1)]
void RasterizeBoids(uint3 id : SV_DispatchThreadID) {
  uint i = getBoidIndex(id);
  if (i >= numBoids) {
    return;
  }

  Boid boid = boids[i];
  RasterizeBoid(boid.pos, boid.vel);
}
