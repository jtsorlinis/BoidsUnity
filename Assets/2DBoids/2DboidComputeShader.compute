#define boidBlockSize 256

#include "BoidRaster.hlsl"

struct Boid {
  float2 pos;
  float2 vel;
};

StructuredBuffer<Boid> boidsIn;
RWStructuredBuffer<Boid> boidsOut;
uniform uint numBoids;
uniform uint boidStride;
uniform float deltaTime;
uniform float maxSpeed;
uniform float minSpeed;
uniform float visualRangeSq;
uniform float cohesionFactor;
uniform float separationFactor;
uniform float alignmentFactor;
uniform float minDistanceSq;
uniform float turnSpeed;
uniform float xBound;
uniform float yBound;

StructuredBuffer<uint> gridOffsetBuffer;
StructuredBuffer<uint> sortedIndices;
RWStructuredBuffer<uint> gridOffsetBufferIn;
RWStructuredBuffer<uint2> gridBuffer;
float gridInverseCellSize;
uint gridDimY;
uint gridDimX;

uint getGridID(Boid boid) {
  int x = (int)floor(boid.pos.x * gridInverseCellSize) + (int)(gridDimX / 2);
  int y = (int)floor(boid.pos.y * gridInverseCellSize) + (int)(gridDimY / 2);
  return (gridDimX * y) + x;
}

uint getBoidIndex(uint3 id) {
  return id.y * boidStride + id.x;
}

#define searchBlockSize 128
#define tileSize 256
#define stagePasses ((tileSize + searchBlockSize - 1) / searchBlockSize)
groupshared float4 tile[tileSize];
uniform uint updateGroupsX;

void AddNeighbour(float2 pos, float2 otherPos, float2 otherVel, inout float2 center, inout float2 close, inout float2 avgVel, inout uint neighbours) {
  float2 diff = pos - otherPos;
  float distSq = dot(diff, diff);
  if (distSq < visualRangeSq && distSq > 0) {
    if (distSq < minDistanceSq) {
      float invDistSq = 1.0 / distSq;
      close += diff * invDistSq;
    }
    center += otherPos;
    avgVel += otherVel;
    neighbours++;
  }
}

void MergedBehaviours(inout Boid boid, uint localID, uint firstCell, uint lastCell) {
  float2 center = 0;
  float2 close = 0;
  float2 avgVel = 0;
  uint neighbours = 0;

  uint cell = getGridID(boid);

  // Loop Around Own Cell
  [loop]
  for (int i = -1; i <= 1; i++) {
    uint row = i * gridDimX;
    uint start = gridOffsetBuffer[cell + row - 1];
    uint end = gridOffsetBuffer[cell + row + 2];
    uint tileStart = gridOffsetBuffer[firstCell + row - 1];
    uint tileCount = gridOffsetBuffer[lastCell + row + 2] - tileStart;
    bool tiled = tileCount <= tileSize;

    GroupMemoryBarrierWithGroupSync();
    if (tiled) {
      [unroll]
      for (uint s = 0; s < stagePasses; s++) {
        uint k = localID + s * searchBlockSize;
        if (k < tileCount) {
          Boid other = boidsIn[sortedIndices[tileStart + k]];
          tile[k] = float4(other.pos, other.vel);
        }
      }
    }
    GroupMemoryBarrierWithGroupSync();

    if (tiled) {
      uint j = start - tileStart;
      uint tileEnd = end - tileStart;
      for (; j + 3 < tileEnd; j += 4) {
        float4 o0 = tile[j];
        float4 o1 = tile[j + 1];
        float4 o2 = tile[j + 2];
        float4 o3 = tile[j + 3];
        AddNeighbour(boid.pos, o0.xy, o0.zw, center, close, avgVel, neighbours);
        AddNeighbour(boid.pos, o1.xy, o1.zw, center, close, avgVel, neighbours);
        AddNeighbour(boid.pos, o2.xy, o2.zw, center, close, avgVel, neighbours);
        AddNeighbour(boid.pos, o3.xy, o3.zw, center, close, avgVel, neighbours);
      }
      for (; j < tileEnd; j++) {
        float4 other = tile[j];
        AddNeighbour(boid.pos, other.xy, other.zw, center, close, avgVel, neighbours);
      }
    } else {
      uint j = start;
      for (; j + 3 < end; j += 4) {
        Boid o0 = boidsIn[sortedIndices[j]];
        Boid o1 = boidsIn[sortedIndices[j + 1]];
        Boid o2 = boidsIn[sortedIndices[j + 2]];
        Boid o3 = boidsIn[sortedIndices[j + 3]];
        AddNeighbour(boid.pos, o0.pos, o0.vel, center, close, avgVel, neighbours);
        AddNeighbour(boid.pos, o1.pos, o1.vel, center, close, avgVel, neighbours);
        AddNeighbour(boid.pos, o2.pos, o2.vel, center, close, avgVel, neighbours);
        AddNeighbour(boid.pos, o3.pos, o3.vel, center, close, avgVel, neighbours);
      }
      for (; j < end; j++) {
        Boid other = boidsIn[sortedIndices[j]];
        AddNeighbour(boid.pos, other.pos, other.vel, center, close, avgVel, neighbours);
      }
    }
  }

  if (neighbours > 0) {
    float invNeighbours = 1.0 / neighbours;
    center *= invNeighbours;
    avgVel *= invNeighbours;
    
    boid.vel += (center - boid.pos) * (cohesionFactor * deltaTime);
    boid.vel += (avgVel - boid.vel) * (alignmentFactor * deltaTime);
  }
  
  boid.vel += close * (separationFactor * deltaTime);
}

void LimitSpeed(inout Boid boid) {
  float speed = length(boid.vel);
  float clampedSpeed = clamp(speed, minSpeed, maxSpeed);
  boid.vel *= clampedSpeed / speed;
}

void KeepInBounds(inout Boid boid) {
  if (abs(boid.pos.x) > xBound) {
    boid.vel.x -= sign(boid.pos.x) * deltaTime * turnSpeed;
  }
  if (abs(boid.pos.y) > yBound) {
    boid.vel.y -= sign(boid.pos.y) * deltaTime * turnSpeed;
  }
}

#pragma kernel UpdateBoids // ID 0
[numthreads(searchBlockSize, 1, 1)]
void UpdateBoids(uint3 groupID : SV_GroupID, uint localID : SV_GroupIndex) {
  uint first = (groupID.y * updateGroupsX + groupID.x) * searchBlockSize;
  if (first >= numBoids) {
    return;
  }
  // Threads past the last boid still take part in the staging, as copies of the last boid
  uint last = min(first + searchBlockSize, numBoids) - 1;
  uint i = first + localID;
  Boid boid = boidsIn[sortedIndices[min(i, last)]];
  uint firstCell = getGridID(boidsIn[sortedIndices[first]]);
  uint lastCell = getGridID(boidsIn[sortedIndices[last]]);

  MergedBehaviours(boid, localID, firstCell, lastCell);
  LimitSpeed(boid);
  KeepInBounds(boid);

  // Update positions
  boid.pos += boid.vel * deltaTime;

  if (i < numBoids) {
    boidsOut[i] = boid;
    uint cell = getGridID(boid);
    uint rank;
    InterlockedAdd(gridOffsetBufferIn[cell], 1, rank);
    gridBuffer[i] = uint2(cell, rank);

    // Drawing here saves a separate pass over every boid
    RasterizeBoid(boid.pos, boid.vel);
  }
}


// Stateless random generation
uint randSeed;
uint pcg_hash(uint input) {
  uint state = input * 747796405u + 2891336453u;
  uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
  return (word >> 22u) ^ word;
}

float randPCG(uint input, float min, float max) {
  float f = pcg_hash(input) * (1.0 / 4294967296.0);
  return f * (max - min) + min;
}


#pragma kernel GenerateBoids // ID 1
[numthreads(boidBlockSize, 1, 1)]
void GenerateBoids(uint3 id : SV_DispatchThreadID) {
  uint i = getBoidIndex(id);
  if (i >= numBoids) {
    return;
  }

  uint base = randSeed + i * 4u;
  boidsOut[i].pos = float2(randPCG(base + 0u, -xBound, xBound), randPCG(base + 1u, -yBound, yBound));
  boidsOut[i].vel = float2(randPCG(base + 2u, -maxSpeed, maxSpeed), randPCG(base + 3u, -maxSpeed, maxSpeed));
}
